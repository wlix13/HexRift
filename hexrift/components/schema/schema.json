{
  "$defs": {
    "AccessType": {
      "description": "User access types (used in users[].access).",
      "enum": [
        "xhttp",
        "server",
        "cdn",
        "proxy",
        "wireguard",
        "xdns"
      ],
      "title": "AccessType",
      "type": "string"
    },
    "AuthMethod": {
      "description": "Encryption keys.",
      "enum": [
        "mlkem768",
        "x25519"
      ],
      "title": "AuthMethod",
      "type": "string"
    },
    "CdnConfig": {
      "additionalProperties": false,
      "properties": {
        "exit_domain": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Exit Domain",
          "type": "string"
        },
        "hub_domain": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Hub Domain",
          "type": "string"
        },
        "trusted_forwarded_headers": {
          "items": {
            "type": "string"
          },
          "title": "Trusted Forwarded Headers",
          "type": "array"
        }
      },
      "required": [
        "exit_domain",
        "hub_domain"
      ],
      "title": "CdnConfig",
      "type": "object"
    },
    "DefaultsConfig": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "$ref": "#/$defs/ExitDefaults"
        },
        "hub": {
          "$ref": "#/$defs/HubDefaults"
        }
      },
      "required": [
        "exit",
        "hub"
      ],
      "title": "DefaultsConfig",
      "type": "object"
    },
    "DnsServerConfig": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "default": "127.0.0.1",
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 53,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "DnsServerConfig",
      "type": "object"
    },
    "ExitConnectionsConfig": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/HandshakeMethod"
        },
        "fingerprint": {
          "$ref": "#/$defs/TlsFingerprint",
          "default": "edge"
        }
      },
      "required": [
        "method"
      ],
      "title": "ExitConnectionsConfig",
      "type": "object"
    },
    "ExitDefaults": {
      "additionalProperties": false,
      "properties": {
        "ipv6": {
          "title": "Ipv6",
          "type": "boolean"
        },
        "haproxy": {
          "default": true,
          "title": "Haproxy",
          "type": "boolean"
        },
        "keys": {
          "$ref": "#/$defs/KeysConfig"
        },
        "observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservabilityOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ipv6",
        "keys"
      ],
      "title": "ExitDefaults",
      "type": "object"
    },
    "ExitRoute": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "domains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domains"
        },
        "ips": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ips"
        }
      },
      "required": [
        "destination"
      ],
      "title": "ExitRoute",
      "type": "object"
    },
    "GlobalConfig": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Namespace",
          "type": "string"
        },
        "aphelion_domain": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Aphelion Domain",
          "type": "string"
        },
        "cdn": {
          "anyOf": [
            {
              "$ref": "#/$defs/CdnConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dns": {
          "$ref": "#/$defs/DnsServerConfig"
        },
        "observability": {
          "$ref": "#/$defs/ObservabilityConfig"
        }
      },
      "required": [
        "namespace",
        "aphelion_domain"
      ],
      "title": "GlobalConfig",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "short_id": {
          "anyOf": [
            {
              "maxLength": 16,
              "pattern": "^[0-9a-fA-F]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Id"
        }
      },
      "required": [
        "id"
      ],
      "title": "Group",
      "type": "object"
    },
    "HandshakeMethod": {
      "description": "Vless encryption handshake methods.",
      "enum": [
        "mlkem768x25519plus"
      ],
      "title": "HandshakeMethod",
      "type": "string"
    },
    "HubDefaults": {
      "additionalProperties": false,
      "properties": {
        "proxy_inbound": {
          "default": false,
          "title": "Proxy Inbound",
          "type": "boolean"
        },
        "ipv6": {
          "title": "Ipv6",
          "type": "boolean"
        },
        "haproxy": {
          "default": true,
          "title": "Haproxy",
          "type": "boolean"
        },
        "keys": {
          "$ref": "#/$defs/KeysConfig"
        },
        "exit_connections": {
          "$ref": "#/$defs/ExitConnectionsConfig"
        },
        "reality": {
          "$ref": "#/$defs/RealityConfig"
        },
        "xdns": {
          "anyOf": [
            {
              "$ref": "#/$defs/XdnsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wireguard": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireguardConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observatory": {
          "$ref": "#/$defs/ObservatoryConfig"
        },
        "observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservabilityOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ipv6",
        "keys",
        "exit_connections",
        "reality"
      ],
      "title": "HubDefaults",
      "type": "object"
    },
    "HubRoute": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "domains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domains"
        },
        "ips": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ips"
        },
        "users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Users"
        },
        "proxy_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Users"
        }
      },
      "required": [
        "destination"
      ],
      "title": "HubRoute",
      "type": "object"
    },
    "KeysConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "session_time": {
          "pattern": "^\\d+(ms|s|m|h)$",
          "title": "Session Time",
          "type": "string"
        },
        "auth": {
          "$ref": "#/$defs/AuthMethod",
          "default": "mlkem768"
        },
        "padding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Padding"
        }
      },
      "required": [
        "mode",
        "session_time"
      ],
      "title": "KeysConfig",
      "type": "object"
    },
    "LbRole": {
      "description": "Load balancer node roles.",
      "enum": [
        "backup"
      ],
      "title": "LbRole",
      "type": "string"
    },
    "LbStrategy": {
      "description": "Load balancer selection strategies.",
      "enum": [
        "random",
        "roundRobin",
        "leastPing",
        "leastLoad"
      ],
      "title": "LbStrategy",
      "type": "string"
    },
    "LeastLoadSettings": {
      "additionalProperties": false,
      "properties": {
        "baselines": {
          "default": [
            "30ms",
            "100ms",
            "250ms"
          ],
          "items": {
            "pattern": "^\\d+(ms|s)$",
            "type": "string"
          },
          "title": "Baselines",
          "type": "array"
        },
        "expected": {
          "default": 1,
          "minimum": 1,
          "title": "Expected",
          "type": "integer"
        },
        "max_rtt": {
          "default": "750ms",
          "pattern": "^\\d+(ms|s)$",
          "title": "Max Rtt",
          "type": "string"
        },
        "tolerance": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "title": "LeastLoadSettings",
      "type": "object"
    },
    "LogLevel": {
      "description": "Xray log verbosity levels.",
      "enum": [
        "none",
        "debug",
        "info",
        "warning",
        "error"
      ],
      "title": "LogLevel",
      "type": "string"
    },
    "LoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "loglevel": {
          "$ref": "#/$defs/LogLevel",
          "default": "none"
        },
        "access": {
          "default": "none",
          "title": "Access",
          "type": "string"
        },
        "error": {
          "default": "none",
          "title": "Error",
          "type": "string"
        },
        "dns_log": {
          "default": false,
          "title": "Dns Log",
          "type": "boolean"
        }
      },
      "title": "LoggingConfig",
      "type": "object"
    },
    "LoggingOverride": {
      "additionalProperties": false,
      "properties": {
        "loglevel": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "access": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "dns_log": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dns Log"
        }
      },
      "title": "LoggingOverride",
      "type": "object"
    },
    "MetricsConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "listen": {
          "default": "127.0.0.1",
          "format": "ipvanyaddress",
          "title": "Listen",
          "type": "string"
        },
        "port": {
          "default": 10085,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user_stats": {
          "default": true,
          "title": "User Stats",
          "type": "boolean"
        },
        "online": {
          "default": true,
          "title": "Online",
          "type": "boolean"
        }
      },
      "title": "MetricsConfig",
      "type": "object"
    },
    "MetricsOverride": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "listen": {
          "anyOf": [
            {
              "format": "ipvanyaddress",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listen"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "user_stats": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Stats"
        },
        "online": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Online"
        }
      },
      "title": "MetricsOverride",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "hostname": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Hostname",
          "type": "string"
        },
        "ipv6": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ipv6"
        },
        "haproxy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Haproxy"
        },
        "lb_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/LbRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reality": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealityConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keys": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeKeysOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_connections": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeExitConnectionsOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proxy_inbound": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Inbound"
        },
        "xdns": {
          "anyOf": [
            {
              "$ref": "#/$defs/XdnsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wireguard": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeWireguardOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservabilityOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "hostname"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeExitConnectionsOverride": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandshakeMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsFingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "NodeExitConnectionsOverride",
      "type": "object"
    },
    "NodeKeysOverride": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "session_time": {
          "anyOf": [
            {
              "pattern": "^\\d+(ms|s|m|h)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Time"
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "padding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Padding"
        }
      },
      "title": "NodeKeysOverride",
      "type": "object"
    },
    "NodeWireguardOverride": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "mtu": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 576,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtu"
        },
        "subnet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subnet"
        },
        "keepalive": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keepalive"
        },
        "kernel_mode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kernel Mode"
        }
      },
      "title": "NodeWireguardOverride",
      "type": "object"
    },
    "ObservabilityConfig": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/$defs/MetricsConfig"
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig"
        }
      },
      "title": "ObservabilityConfig",
      "type": "object"
    },
    "ObservabilityOverride": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricsOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logging": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoggingOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ObservabilityOverride",
      "type": "object"
    },
    "ObservatoryConfig": {
      "additionalProperties": false,
      "properties": {
        "sampling": {
          "default": 8,
          "maximum": 24,
          "minimum": 1,
          "title": "Sampling",
          "type": "integer"
        },
        "interval": {
          "default": "15s",
          "pattern": "^\\d+(ms|s|m|h)$",
          "title": "Interval",
          "type": "string"
        },
        "timeout": {
          "default": "5s",
          "pattern": "^\\d+(ms|s|m|h)$",
          "title": "Timeout",
          "type": "string"
        },
        "concurrency": {
          "default": true,
          "title": "Concurrency",
          "type": "boolean"
        }
      },
      "title": "ObservatoryConfig",
      "type": "object"
    },
    "Portal": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Label",
          "type": "string"
        },
        "routes": {
          "$ref": "#/$defs/PortalRoutes"
        }
      },
      "required": [
        "label",
        "routes"
      ],
      "title": "Portal",
      "type": "object"
    },
    "PortalRoutes": {
      "additionalProperties": false,
      "properties": {
        "domains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domains"
        },
        "ips": {
          "anyOf": [
            {
